{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "automerge": true,
  "labels": [
    "chore"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions in a Dockerfile, marked with a renovate comment on the line above",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\nARG [A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "aislop and PMD gate CI and can add rules in any release, so check each update by hand. PMD also needs its new checksum.",
      "matchPackageNames": [
        "aislop",
        "pmd/pmd"
      ],
      "automerge": false
    },
    {
      "description": "Pick a new Java major by hand",
      "matchDatasources": [
        "java-version"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Keycloak changes its internal APIs between minor versions, so check each update by hand",
      "matchPackageNames": [
        "org.keycloak:**"
      ],
      "automerge": false
    }
  ]
}

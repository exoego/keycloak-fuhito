<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="0.1.0-hierarchy" author="keycloak-fuhito">
        <createTable tableName="FUHITO_HIERARCHY">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="PK_FUHITO_HIERARCHY" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="FUHITO_HIERARCHY" columnNames="REALM_ID, CODE"
                             constraintName="UK_FUHITO_HIERARCHY_CODE"/>
    </changeSet>
    <changeSet id="0.1.0-ref-item" author="keycloak-fuhito">
        <createTable tableName="FUHITO_REF_ITEM">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="PK_FUHITO_REF_ITEM" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="KIND" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NAMES_I18N" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="DISPLAY_ORDER" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ATTRIBUTES" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="ACTIVE" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="FUHITO_REF_ITEM" columnNames="REALM_ID, KIND, CODE"
                             constraintName="UK_FUHITO_REF_ITEM_CODE"/>
    </changeSet>
    <changeSet id="0.1.0-org-unit" author="keycloak-fuhito">
        <createTable tableName="FUHITO_ORG_UNIT">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="PK_FUHITO_ORG_UNIT" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(64)"/>
            <column name="EXTERNAL_ID" type="VARCHAR(255)"/>
            <column name="SOURCE" type="VARCHAR(64)"/>
            <column name="KC_ORG_ID" type="VARCHAR(36)"/>
        </createTable>
        <addUniqueConstraint tableName="FUHITO_ORG_UNIT" columnNames="REALM_ID, CODE"
                             constraintName="UK_FUHITO_ORG_UNIT_CODE"/>
        <addUniqueConstraint tableName="FUHITO_ORG_UNIT" columnNames="REALM_ID, SOURCE, EXTERNAL_ID"
                             constraintName="UK_FUHITO_ORG_UNIT_EXTERNAL"/>

        <createTable tableName="FUHITO_ORG_UNIT_VERSION">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="PK_FUHITO_ORG_UNIT_VERSION" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ORG_UNIT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_FROM" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_TO" type="DATE"/>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NAMES_I18N" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="SHORT_NAME" type="VARCHAR(255)"/>
            <column name="SHORT_NAMES_I18N" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="PHONETIC_NAME" type="VARCHAR(255)"/>
            <column name="UNIT_TYPE_ID" type="VARCHAR(36)"/>
            <column name="DISPLAY_ORDER" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ATTRIBUTES" type="CLOB">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="FUHITO_ORG_UNIT_VERSION" baseColumnNames="ORG_UNIT_ID"
                                 referencedTableName="FUHITO_ORG_UNIT" referencedColumnNames="ID"
                                 constraintName="FK_FUHITO_ORG_UNIT_VERSION_UNIT"/>
        <addForeignKeyConstraint baseTableName="FUHITO_ORG_UNIT_VERSION" baseColumnNames="UNIT_TYPE_ID"
                                 referencedTableName="FUHITO_REF_ITEM" referencedColumnNames="ID"
                                 constraintName="FK_FUHITO_ORG_UNIT_VERSION_TYPE"/>
        <addUniqueConstraint tableName="FUHITO_ORG_UNIT_VERSION" columnNames="ORG_UNIT_ID, VALID_FROM"
                             constraintName="UK_FUHITO_ORG_UNIT_VERSION_FROM"/>
        <createIndex tableName="FUHITO_ORG_UNIT_VERSION" indexName="IDX_FUHITO_ORG_UNIT_VERSION_REALM">
            <column name="REALM_ID"/>
            <column name="VALID_FROM"/>
        </createIndex>

        <createTable tableName="FUHITO_ORG_UNIT_LINK">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="PK_FUHITO_ORG_UNIT_LINK" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="HIERARCHY_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="CHILD_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="PARENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_FROM" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_TO" type="DATE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="FUHITO_ORG_UNIT_LINK" baseColumnNames="HIERARCHY_ID"
                                 referencedTableName="FUHITO_HIERARCHY" referencedColumnNames="ID"
                                 constraintName="FK_FUHITO_ORG_UNIT_LINK_HIERARCHY"/>
        <addForeignKeyConstraint baseTableName="FUHITO_ORG_UNIT_LINK" baseColumnNames="CHILD_ID"
                                 referencedTableName="FUHITO_ORG_UNIT" referencedColumnNames="ID"
                                 constraintName="FK_FUHITO_ORG_UNIT_LINK_CHILD"/>
        <addForeignKeyConstraint baseTableName="FUHITO_ORG_UNIT_LINK" baseColumnNames="PARENT_ID"
                                 referencedTableName="FUHITO_ORG_UNIT" referencedColumnNames="ID"
                                 constraintName="FK_FUHITO_ORG_UNIT_LINK_PARENT"/>
        <addUniqueConstraint tableName="FUHITO_ORG_UNIT_LINK" columnNames="HIERARCHY_ID, CHILD_ID, VALID_FROM"
                             constraintName="UK_FUHITO_ORG_UNIT_LINK_FROM"/>
        <createIndex tableName="FUHITO_ORG_UNIT_LINK" indexName="IDX_FUHITO_ORG_UNIT_LINK_PARENT">
            <column name="HIERARCHY_ID"/>
            <column name="PARENT_ID"/>
        </createIndex>
    </changeSet>
    <!-- The exclusion constraints below need btree_gist. A database user that may not create it keeps working.
         The application checks the same rules, and these two change sets run again at the next start. -->
    <changeSet id="0.1.0-btree-gist" author="keycloak-fuhito" dbms="postgresql" failOnError="false">
        <sql>CREATE EXTENSION IF NOT EXISTS btree_gist</sql>
    </changeSet>

    <changeSet id="0.1.0-org-unit-no-overlap" author="keycloak-fuhito" dbms="postgresql">
        <preConditions onFail="CONTINUE">
            <sqlCheck expectedResult="1">SELECT count(*) FROM pg_extension WHERE extname = 'btree_gist'</sqlCheck>
        </preConditions>
        <sql>
            ALTER TABLE FUHITO_ORG_UNIT_VERSION ADD CONSTRAINT EX_FUHITO_ORG_UNIT_VERSION_PERIOD
            EXCLUDE USING gist (ORG_UNIT_ID WITH =, daterange(VALID_FROM, VALID_TO) WITH &amp;&amp;)
        </sql>
        <sql>
            ALTER TABLE FUHITO_ORG_UNIT_LINK ADD CONSTRAINT EX_FUHITO_ORG_UNIT_LINK_PERIOD
            EXCLUDE USING gist (HIERARCHY_ID WITH =, CHILD_ID WITH =, daterange(VALID_FROM, VALID_TO) WITH &amp;&amp;)
        </sql>
    </changeSet>
</databaseChangeLog>

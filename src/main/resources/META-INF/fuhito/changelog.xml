        <sql dbms="postgresql">
            CREATE INDEX IDX_FUHITO_ORG_UNIT_OWN_TIME ON FUHITO_ORG_UNIT (REALM_ID)
            WHERE TIME_ZONE IS NOT NULL OR DAY_START IS NOT NULL
        </sql>
        <!-- A realm gets its default hierarchy when it is created. The realms of before the extension get it here. -->
        <sql>
            INSERT INTO FUHITO_HIERARCHY (ID, REALM_ID, CODE, NAME)
            SELECT r.ID, r.ID, 'default', 'Default' FROM REALM r
        </sql>

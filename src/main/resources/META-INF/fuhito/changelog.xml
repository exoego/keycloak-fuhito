             not a key of the table. -->
        <createTable tableName="FUHITO_ASSIGNMENT">
            <column name="ID" type="VARCHAR(36)">
                <constraints primaryKey="true" primaryKeyName="PK_FUHITO_ASSIGNMENT" nullable="false"/>
            </column>
            <column name="REALM_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ASSIGNMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="EMPLOYMENT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="ORG_UNIT_ID" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_FROM" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="VALID_TO" type="DATE"/>
            <column name="JOB_TITLE_ID" type="VARCHAR(36)"/>
            <column name="OCCUPATION_ID" type="VARCHAR(36)"/>
            <column name="KIND_ID" type="VARCHAR(36)"/>
            <column name="WORK_LOCATION_ID" type="VARCHAR(36)"/>
            <column name="COST_CENTER_ID" type="VARCHAR(36)"/>
            <column name="IS_HEAD" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="IS_PRIMARY" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="ALLOCATION_PERCENT" type="DECIMAL(5,2)"/>
            <column name="DISPLAY_ORDER" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ATTRIBUTES" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="SOURCE" type="VARCHAR(64)"/>
            <column name="CONTINUES_ASSIGNMENT_ID" type="VARCHAR(36)"/>
            <!-- The version of the assignment. Every row of one assignment has the same one. -->
            <column name="VERSION" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="FUHITO_ASSIGNMENT" columnNames="ASSIGNMENT_ID, VALID_FROM"
